import "class" : new ;
import build-request ;
import feature ;
import modules ;
import path ;
import project ;
import property-set ;
import targets ;

rule register-lint-header ( file : target )
{
    .lint-header.$(file) = $(target) ;
}

# Resolve consumers exactly as B2 does, but return only provider artifacts.
# Requesting existing filenames on B2's command line instead would treat them
# as input files and update every consumer in the original request.
class provider-lint-headers-target : basic-target
{
    import errors ;
    import modules ;
    import property-set ;

    rule __init__ ( name : project : sources * : requirements *
        : default-build * : usage-requirements * )
    {
        basic-target.__init__ $(name) : $(project) : $(sources) :
            $(requirements) : $(default-build) : $(usage-requirements) ;
    }

    rule construct ( name : source-targets * : properties )
    {
        # Generate each original top-level request independently. Making them
        # sources of this target would propagate its defaults into own lanes.
        for local request in [ modules.peek webcpp-lint-headers : .lint-properties ]
        {
            for local source in [ modules.peek webcpp-lint-headers : .lint-sources ]
            {
                local target = [ $(self.project).find $(source) ] ;
                local generated = [ $(target).generate $(request) ] ;
            }
        }
        local selected ;
        for local file in [ modules.peek webcpp-lint-headers : .lint-requested-headers ]
        {
            local target = [ modules.peek webcpp-lint-headers : .lint-header.$(file) ] ;
            if ! $(target)
            {
                errors.user-error "No provider header variant was generated for" $(file) ;
            }
            selected += $(target) ;
        }
        return [ property-set.empty ] $(selected) ;
    }
}

rule declare-lint-headers ( )
{
    local arguments = [ modules.peek : ARGV ] ;
    .lint-sources = [ MATCH "^--webcpp-lint-source=(.*)$" : $(arguments) ] ;
    for local file in [ MATCH "^--webcpp-lint-header=(.*)$" : $(arguments) ]
    {
        .lint-requested-headers += [ path.make $(file) ] ;
    }
    local properties = [ MATCH "^--webcpp-lint-property=(.*)$" : $(arguments) ] ;
    if $(properties)
    {
        local converted = [ build-request.convert-command-line-elements $(properties) ] ;
        for local expanded in [ build-request.expand-no-defaults $(converted) ]
        {
            .lint-properties += [ property-set.create [ feature.split $(expanded) ] ] ;
        }
    }
    else
    {
        .lint-properties = [ property-set.empty ] ;
    }
    if $(.lint-sources) && $(.lint-requested-headers)
    {
        targets.create-metatarget provider-lint-headers-target : [ project.current ]
            : lint-provider-headers ;
    }
}

