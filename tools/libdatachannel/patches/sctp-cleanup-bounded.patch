libdatachannel 0.24.6's SctpTransport::Cleanup() calls usrsctp_finish() until it succeeds, which
it does only once usrsctp holds no endpoint, and it runs under the global initialization lock.
When usrsctp keeps an endpoint it never frees, the cleanup never ends: rtcCleanup() gives up after
ten seconds, and the next rtcPreload(), or any call that initializes libdatachannel again, waits
forever for that lock. webcpp::webrtc's native test, which makes and destroys a runtime per test,
hung so about once in 3000 runs on MSVC 14.5 x64 (2026-11-23): its dumps showed the cleanup in
this loop, the main thread in rtcPreload(), and usrsctp holding one endpoint whose association,
past its SHUTDOWN, had no timer and no reference left to free it. This patch bounds the wait to
five seconds, within rtcCleanup()'s ten: past it usrsctp stays initialized, with the set of
transports, and the next initialization uses it rather than initializing it again. Remove this
file once the libdatachannel that tools/libdatachannel/pin.json pins bounds its SCTP cleanup:
build.py then fails, saying so.

This patch changes files of libdatachannel, which the Mozilla Public License 2.0 covers, and is
itself under that licence.

diff --git a/src/impl/sctptransport.cpp b/src/impl/sctptransport.cpp
--- a/src/impl/sctptransport.cpp
+++ b/src/impl/sctptransport.cpp
@@ -84,8 +84,12 @@
 
 SctpTransport::InstancesSet* SctpTransport::Instances = nullptr;
 
+// Whether usrsctp is initialized: Cleanup() leaves it so when it cannot finish.
+static bool UsrsctpInitialized = false;
+
 void SctpTransport::Init() {
-	usrsctp_init(0, SctpTransport::WriteCallback, SctpTransport::DebugCallback);
+	if (!std::exchange(UsrsctpInitialized, true))
+		usrsctp_init(0, SctpTransport::WriteCallback, SctpTransport::DebugCallback);
 	usrsctp_sysctl_set_sctp_pr_enable(1);  // Enable Partial Reliability Extension (RFC 3758)
 	usrsctp_sysctl_set_sctp_ecn_enable(0); // Disable Explicit Congestion Notification
 #ifndef SCTP_ACCEPT_ZERO_CHECKSUM
@@ -95,7 +99,8 @@
 	usrsctp_sysctl_set_sctp_debug_on(SCTP_DEBUG_ALL);
 #endif
 
-	Instances = new InstancesSet;
+	if (!Instances)
+		Instances = new InstancesSet;
 }
 
 void SctpTransport::SetSettings(const SctpSettings &s) {
@@ -148,11 +153,20 @@
 }
 
 void SctpTransport::Cleanup() {
-	while (usrsctp_finish())
+	// usrsctp_finish() fails while usrsctp still holds an endpoint, and an endpoint whose
+	// association usrsctp never frees is held forever. Waiting for it would hold the global lock
+	// forever, and the next initialization would wait for it too: after a bound, usrsctp stays
+	// initialized, with the instances, for the next initialization to use.
+	for (int attempt = 0; attempt < 50; ++attempt) {
+		if (usrsctp_finish() == 0) {
+			UsrsctpInitialized = false;
+			delete Instances;
+			Instances = nullptr;
+			return;
+		}
 		std::this_thread::sleep_for(100ms);
-
-	delete Instances;
-	Instances = nullptr;
+	}
+	PLOG_WARNING << "SCTP cleanup incomplete: usrsctp still holds an endpoint, it stays initialized";
 }
 
 SctpTransport::SctpTransport(shared_ptr<Transport> lower, const Configuration &config, Ports ports,
