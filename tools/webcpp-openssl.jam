import "class" : new ;
import errors ;
import feature ;
import path ;
import project ;
import property-set ;
import targets ;
import toolset ;
import type ;
import virtual-target ;
import webcpp-wasi ;

feature.feature webcpp-openssl-tests : on : optional propagated ;
type.register WEBCPP_OPENSSL_TESTS ;

class openssl-target : basic-target
{
    import "class" : new ;
    import errors ;
    import path ;
    import modules ;
    import property-set ;
    import regex ;
    import toolset ;
    import virtual-target ;
    rule __init__ ( name : project : sources * : requirements *
        : default-build * : usage-requirements * )
    {
        basic-target.__init__ $(name) : $(project) : $(sources) :
            $(requirements) : $(default-build) : $(usage-requirements) ;
    }

    rule construct ( name : source-targets * : properties )
    {
        local root = [ modules.peek webcpp-openssl : .root ] ;
        if ! [ path.exists [ path.native $(root)/third_party/libs/openssl/Configure ] ]
        {
            errors.user-error "OpenSSL sources are missing. Run: git submodule update --init third_party/libs/openssl" ;
        }
        local os = [ $(properties).get <target-os> ] ;
        local tool = [ $(properties).get <toolset> ] ;
        local version = [ $(properties).get <toolset-clang:version> ] ;
        if $(os) = wasi && [ $(properties).get <webcpp-openssl-tests> ] = "on"
        {
            errors.user-error "The OpenSSL upstream test harness requires native executables."
                "WASIp3 uses the separately declared TLS integration tests." ;
        }
        if ! ( ( $(tool) in clang gcc && $(os) in darwin linux )
            || ( $(tool) = clang && $(os) = wasi && $(version) = wasip3 )
            || ( $(tool) = msvc && $(os) = windows ) )
        {
            errors.user-error "Source-built OpenSSL supports native Clang/GCC on macOS/Linux, MSVC on Windows, and clang-wasip3."
                "Other targets are not supported by this recipe." ;
        }
        # B2's normal directory omits free flags. Add the effective compiler
        # configuration so changing cflags or a user-config tool cannot reuse
        # archives or headers from the previous configuration.
        local relevant = [ toolset.relevant webcpp-openssl.build ] ;
        properties = [ $(properties).add $(relevant) ] ;
        local fingerprint = [ modules.call-in webcpp-openssl : fingerprint $(properties) ] ;
        local action = [ new action $(source-targets) : webcpp-openssl.build : $(properties) ] ;
        local extension = a ;
        if $(os) = windows { extension = lib ; }
        local ssl = [ new file-target libssl.$(extension) exact : STATIC_LIB : $(self.project) : $(action) ] ;
        local directory = [ path.root [ path.make [ $(ssl).path ] ] [ path.pwd ] ] ;
        directory = $(directory)/config-$(fingerprint) ;
        $(ssl).set-path $(directory) ;
        ssl = [ virtual-target.register $(ssl) ] ;
        local crypto = [ new file-target libcrypto.$(extension) exact : STATIC_LIB : $(self.project) : $(action) ] ;
        $(crypto).set-path $(directory) ;
        crypto = [ virtual-target.register $(crypto) ] ;
        local headers ;
        for local header in [ modules.peek webcpp-openssl : .headers ]
        {
            local generated = [ new file-target include/openssl/$(header) exact
                : H : $(self.project) : $(action) ] ;
            $(generated).set-path $(directory) ;
            headers += [ virtual-target.register $(generated) ] ;
        }
        if [ $(properties).get <webcpp-openssl-tests> ] = "on"
        {
            local proof = [ new file-target upstream-tests.json exact
                : WEBCPP_OPENSSL_TESTS : $(self.project) : $(action) ] ;
            $(proof).set-path $(directory) ;
            headers += [ virtual-target.register $(proof) ] ;
        }
        if $(os) = windows && [ $(properties).get <debug-symbols> ] = "on"
            && [ $(properties).get <debug-store> ] = database
        {
            local symbols = [ new file-target ossl_static.pdb exact
                : PDB : $(self.project) : $(action) ] ;
            $(symbols).set-path $(directory) ;
            headers += [ virtual-target.register $(symbols) ] ;
        }
        return [ property-set.create [ $(relevant).raw ] <include>$(directory)/include
            <dependency>$(headers) ] $(ssl) $(crypto) ;
    }
}

rule declare ( root : headers * : sources * )
{
    .root = $(root) ;
    .headers = $(headers) ;
    targets.create-metatarget openssl-target : [ project.current ] : openssl
        : $(sources) : <link>static <warnings>off <warnings-as-errors>off
            <conditional>@webcpp-openssl.configuration
        : : <target-os>darwin:<linkflags>-Wl,-dead_strip
            <target-os>linux:<linkflags>-Wl,--gc-sections
            <target-os>linux:<linkflags>-ldl
            <target-os>windows:<linkflags>"/OPT:REF ws2_32.lib gdi32.lib advapi32.lib crypt32.lib user32.lib"
            <conditional>@webcpp-openssl.configuration
            <target-os>wasi:<linkflags>"-lwasi-emulated-getpid -lwasi-emulated-signal -lwasi-emulated-process-clocks -lwasi-emulated-mman" ;
}

toolset.uses-features webcpp-openssl.build : <toolset> <target-os> <architecture> <address-model> <variant> <threading> <optimization> <debug-symbols> <inlining> <runtime-link> <runtime-debugging> <cflags> <define> <linkflags> <exception-handling> <lto> <lto-mode> <webcpp-openssl-tests> ;

rule configuration ( properties * )
{
    if <target-os>wasi in $(properties) && <threading>multi in $(properties)
    {
        return [ webcpp-wasi.cooperative $(.root) : $(properties) ] ;
    }
}

rule fingerprint ( ps )
{
    # Toolset variables append to their target. Cache by immutable property set
    # to avoid accumulating flags or building duplicate archives on each visit.
    if $(.fingerprint.$(ps))
    {
        return $(.fingerprint.$(ps)) ;
    }
    local settings = openssl-settings-$(ps) ;
    compiler-settings $(settings) : $(ps) ;
    local values = [ on $(settings) return $(DRIVER) $(C_OPTIONS) $(DEFINES) $(ARCHIVER) $(.SETUP) $(.SETUP-SCRIPT) $(.SETUP-OPTIONS) ] ;
    .fingerprint.$(ps) = [ MD5 "$(values:J=|)" ] ;
    return $(.fingerprint.$(ps)) ;
}

rule compiler-settings ( outputs * : ps )
{
    local compiler = [ $(ps).get <toolset> ] ;
    if $(compiler) = clang
    {
        local platform = [ $(ps).get <toolset-clang:platform> ] ;
        compiler = clang-$(platform) ;
    }
    toolset.set-target-variables $(compiler).compile.c $(outputs) : $(ps) ;
    if $(compiler) = msvc
    {
        # Both operations inherit MSVC's setup flags. Read the archiver on a
        # separate target so the setup script and its arguments occur once.
        local archive-settings = $(outputs[1])-archive ;
        toolset.set-target-variables msvc.archive $(archive-settings) : $(ps) ;
        DRIVER on $(outputs) = [ on $(outputs[1]) return $(.CC[1]) ] ;
        ARCHIVER on $(outputs) = [ on $(archive-settings) return $(.LD[1]) ] ;
        C_OPTIONS on $(outputs) = [ on $(outputs[1]) return $(.CC[2-]) $(OPTIONS) $(CFLAGS) $(USER_CFLAGS) ] ;
    }
    else
    {
        toolset.set-target-variables $(compiler).archive $(outputs) : $(ps) ;
        DRIVER on $(outputs) = [ on $(outputs[1]) return $(CONFIG_COMMAND[1]) ] ;
        ARCHIVER on $(outputs) = [ on $(outputs[1]) return $(.AR:E=ar) ] ;
        C_OPTIONS on $(outputs) = [ on $(outputs[1]) return $(OPTIONS) $(USER_OPTIONS) ] ;
    }
}

rule build ( outputs * : inputs * : properties * )
{
    local ps = [ property-set.create $(properties) ] ;
    compiler-settings $(outputs) : $(ps) ;
    if [ $(ps).get <toolset> ] = msvc
    {
        modules.call-in msvc : set-setup-command $(outputs) : $(properties) ;
    }
    SCRIPT on $(outputs) = [ path.native $(.root)/tools/openssl/build.py ] ;
    SOURCE on $(outputs) = [ path.native $(.root)/third_party/libs/openssl ] ;
    PLATFORM on $(outputs) = [ $(ps).get <target-os> ] ;
    THREADING on $(outputs) = [ $(ps).get <threading> ] ;
    VARIANT on $(outputs) = [ $(ps).get <variant> ] ;
    if [ $(ps).get <webcpp-openssl-tests> ] = "on"
    {
        TEST on $(outputs) = --test ;
    }
}

actions build
{
    $(.SETUP) python3 "$(SCRIPT)" "@($(<[1]:W).rsp:E=--source "$(SOURCE)" --output "$(<[1]:DW)" --platform "$(PLATFORM)" --threading "$(THREADING)" --variant "$(VARIANT)" --cc "$(DRIVER)" --ar "$(ARCHIVER)" $(TEST) -- $(C_OPTIONS) -D$(DEFINES))"
}
