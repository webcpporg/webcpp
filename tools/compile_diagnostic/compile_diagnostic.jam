#
# The test type of webcpp.compile-diagnostic, which tools/webcpp.jam offers:
# the object compiled with clang's -verify, which succeeds only when every
# error its directives state appears, then a check that clang read every
# directive (check.py). -verify ignores the errors it does not expect
# (unless the test is `alone`, see tools/webcpp.jam), so that a header's
# #error may be followed by what the rest of the header then fails on; among
# them are the errors it reports on a directive it cannot
# read, a header it names that cannot be located or a text whose `}}` is not
# on its line, and it drops that directive. The object's compile writes its
# compilation database entry (-MJ), whose exact command check.py runs again
# with clang's diagnostic log, and the test fails on any error located in a
# comment after an expected-<kind> of that comment, or when the compile
# reported no error at all. This file is loaded as the module
# webcpp-compile-diagnostic.
import generators ;
import modules ;
import path ;
import testing ;
import type ;

type.register DIAGNOSTIC_CHECK : diagnostic-check ;
type.register COMPILE_DIAGNOSTIC : : TEST ;
generators.register-standard webcpp-compile-diagnostic.check : OBJ : DIAGNOSTIC_CHECK ;
generators.register-standard testing.expect-success : DIAGNOSTIC_CHECK : COMPILE_DIAGNOSTIC ;

.here = [ path.parent [ path.root [ path.make [ modules.binding $(__name__) ] ] [ path.pwd ] ] ] ;
# The check as a file target of its own, which every check depends on, so
# that a change of it runs each again.
.check = <webcpp-compile-diagnostic>check.py ;
SEARCH on $(.check) = [ path.native $(.here) ] ;

# requirements hold the -verify options and the program's own; sources are
# the test's, as testing.compile takes them.
rule compile-diagnostic ( name : sources + : requirements * )
{
    testing.make-test compile-diagnostic : $(sources) : $(requirements) : $(name) ;
}

# The object's compile, whose variables its toolset has set by now, also
# writes its compilation database entry beside it. A variable of a target is
# read when its action runs, after every rule. clang writes no object for a
# translation unit with errors, so each build compiles it, and writes the
# entry, again.
rule check ( target : sources * : properties * )
{
    local object = $(sources[1]) ;
    local directory = [ on $(object) return $(LOCATE) ] ;
    local database = $(directory)/$(object:G=:S=.compile.json) ;
    OPTIONS on $(object) += "-MJ \"$(database)\"" ;
    DATABASE on $(target) = $(database) ;
    # tools/webcpp.jam's interpreter, which loads this module.
    PYTHON on $(target) = [ modules.peek webcpp : .python ] ;
    CHECK on $(target) = $(.check) ;
    DEPENDS $(target) : $(.check) ;
}

actions check bind CHECK
{
    "$(PYTHON)" "$(CHECK)" --database "$(DATABASE)" --output "$(<)"
}
