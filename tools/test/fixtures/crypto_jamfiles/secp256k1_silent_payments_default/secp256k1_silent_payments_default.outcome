[all]
targets: native wasip2 wasip3 emscripten
build: succeeds
run: app
# tag::output[]
[native]
silent payments ok backend=secp256k1
[wasip2]
silent payments ok backend=secp256k1
[wasip3]
silent payments ok backend=secp256k1
[emscripten]
silent payments ok backend=secp256k1
# end::output[]
