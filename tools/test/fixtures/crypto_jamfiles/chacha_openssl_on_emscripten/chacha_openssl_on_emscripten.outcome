# The compiler's line of the refusal starts with the header's path on the machine, so the message is
# a contains: line. OpenSSL is not built for Emscripten, and the refusal says so on Emscripten
# alone: no message test or MSVC case has it.
[all]
targets: emscripten
build: fails
# tag::messages[]
contains: webcpp::crypto: openssl has no ChaCha20-Poly1305 on emscripten. The backends that have it: sodium (native, wasip2, wasip3, emscripten), bearssl (native, wasip2, wasip3, emscripten), openssl (native, wasip2, wasip3).
# end::messages[]
