[all]
targets: native wasip2 wasip3 emscripten
build: succeeds
run: app
# tag::output[]
[native]
aes256_gcm ok backend=openssl
schnorr ok
[wasip2]
aes256_gcm ok backend=bearssl
schnorr ok
[wasip3]
aes256_gcm ok backend=bearssl
schnorr ok
[emscripten]
aes256_gcm ok backend=bearssl
schnorr ok
# end::output[]
