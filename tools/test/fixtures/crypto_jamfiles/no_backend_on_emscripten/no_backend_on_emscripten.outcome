# The compiler's line of the refusal starts with the header's path on the machine, so the
# message is a contains: line. On wasip2 and wasip3, where OpenSSL has AES-GCM too, the message
# names it as well (test/messages/no_backend_wasm); compile-diagnostic is clang's and skips
# Emscripten, so this fixture is the Emscripten one.
[all]
targets: emscripten
build: fails
# tag::messages[]
contains: webcpp::crypto: AES-GCM's default backend on this target is BearSSL, which is not linked, and the one backend that has it there. Add /third_party//bearssl to the program's Jamfile, as in: exe app : app.cpp /webcpp/crypto//crypto /third_party//bearssl ; (without b2: define WEBCPP_CRYPTO_HAS_BEARSSL=1 and link BearSSL built with webcpp's src/canary_bearssl.c)
# end::messages[]
