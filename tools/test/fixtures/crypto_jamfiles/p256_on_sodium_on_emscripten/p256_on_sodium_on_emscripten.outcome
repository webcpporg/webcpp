# The compiler's line of the refusal starts with the header's path on the machine, so the message is
# a contains: line. wasip2 and wasip3 have the same message in a compile-diagnostic
# (test/messages/p256_on_sodium); compile-diagnostic is clang's and skips Emscripten, so this
# fixture is the Emscripten one.
[all]
targets: emscripten
build: fails
# tag::messages[]
contains: webcpp::crypto: sodium has no P-256. The backends that have it: bearssl (native, wasip2, wasip3, emscripten).
# end::messages[]
