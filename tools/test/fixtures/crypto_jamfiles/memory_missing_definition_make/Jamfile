# The memory option given as spec section 7.3 says, in the requirements of the
# program's project with OpenSSL beside it, and openssl_memory_resource() not
# defined.
# tag::jamfile[]
project app
  : requirements <define>WEBCPP_CRYPTO_OPENSSL_MEMORY_RESOURCE <library>/webcpp/crypto//openssl ;

exe app : app.cpp /webcpp/crypto//crypto ;
# end::jamfile[]
