# The compiler's line of the refusal starts with the header's path on the machine, so the message is
# a contains: line. wasip2 and wasip3 have the same message in a compile-diagnostic
# (test/messages/box_not_a_family); compile-diagnostic is clang's and skips Emscripten, so this
# fixture is the Emscripten one.
[all]
targets: emscripten
build: fails
# tag::messages[]
contains: webcpp::crypto: public_key_encryption::basic_box takes a box family: families::box_xsalsa20poly1305 or families::box_xchacha20poly1305.
# end::messages[]
