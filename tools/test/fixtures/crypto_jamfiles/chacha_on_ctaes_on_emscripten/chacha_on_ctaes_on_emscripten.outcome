# The compiler's line of the static_assert starts with the header's path on the machine, so the
# message is a contains: line. Natively and on wasip2 and wasip3 the same message is a
# compile-diagnostic (test/messages/chacha_on_ctaes); compile-diagnostic is clang's and skips
# Emscripten, so this fixture is the Emscripten one.
[all]
targets: emscripten
build: fails
# tag::messages[]
contains: webcpp::crypto: ctaes has no ChaCha20-Poly1305. The backends that have it: sodium (native, wasip2, wasip3, emscripten), bearssl (native, wasip2, wasip3, emscripten), openssl (native, wasip2, wasip3).
# end::messages[]
