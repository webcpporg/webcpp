# The compiler's line of the static_assert starts with the header's path on the machine, so the
# message is a contains: line. wasip2 and wasip3 have the same message in a compile-diagnostic
# (test/messages/ed25519ph_sha256); compile-diagnostic is clang's and skips Emscripten, so this
# fixture is the Emscripten one.
[all]
targets: emscripten
build: fails
# tag::messages[]
contains: webcpp::crypto: Ed25519ph is defined over SHA-512 (RFC 8032 section 5.1); name curves::ed25519::ph<webcpp::hash::sha2_512>.
# end::messages[]
