# The compiler's line of the refusal starts with the header's path on the machine, so the message is
# a contains: line. wasip2 and wasip3 have the same message in a compile-diagnostic
# (test/messages/p256_default_not_linked); compile-diagnostic is clang's and skips Emscripten, so
# this fixture is the Emscripten one.
[all]
targets: emscripten
build: fails
# tag::messages[]
contains: webcpp::crypto: P-256's default backend on this target is BearSSL, which is not linked, and the one backend that has it there. Add /webcpp/crypto//p256-default, the default's library on every target, to the program's Jamfile, as in: exe app : app.cpp /webcpp/crypto//crypto /webcpp/crypto//p256-default ; (without b2: define WEBCPP_CRYPTO_HAS_BEARSSL=1 and link BearSSL built with webcpp's src/canary_bearssl.c)
# end::messages[]
