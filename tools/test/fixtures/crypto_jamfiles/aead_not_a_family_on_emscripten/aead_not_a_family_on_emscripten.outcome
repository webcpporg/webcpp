# The compiler's line of the static_assert starts with the header's path on the machine, so the
# message is a contains: line. Natively and on wasip2 and wasip3 the same message is a
# compile-diagnostic (test/messages/aead_not_a_family); compile-diagnostic is clang's and skips
# Emscripten, so this fixture is the Emscripten one.
[all]
targets: emscripten
build: fails
# tag::messages[]
contains: webcpp::crypto: ciphers::basic_chacha20_poly1305 takes an AEAD family: families::chacha20_poly1305, families::chacha20_poly1305_original or families::xchacha20_poly1305.
# end::messages[]
