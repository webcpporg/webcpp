# The compiler's line of the refusal starts with the header's path on the machine, so the message is
# a contains: line. wasip2 and wasip3 have the same message in a compile-diagnostic
# (test/messages/erase_secret_const_range); compile-diagnostic is clang's and skips Emscripten, so this
# fixture is the Emscripten one.
[all]
targets: emscripten
build: fails
# tag::messages[]
contains: webcpp::secure: erase_secret zeroes a buffer the program may write, of trivially copyable elements: a std::vector<std::uint8_t>, a std::string, a std::array, a std::span<std::byte>; this range's elements are const or not trivially copyable.
# end::messages[]
