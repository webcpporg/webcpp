# The compiler's line starts with the header's path on the machine, so the
# message is a contains: line. Natively and on WASI the same text is
# test/messages/argon2d_on_sodium, a compile-diagnostic.
[all]
targets: emscripten
build: fails
contains: webcpp::hash: kdfs::argon2d is not in this backend. Name one of: backends::openssl.
