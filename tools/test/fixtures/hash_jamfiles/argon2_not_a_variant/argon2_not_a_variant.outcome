# The compiler's line starts with the header's path on the machine, so the
# message is a contains: line. Natively and on WASI the same text is
# test/messages/argon2_not_a_variant, a compile-diagnostic.
[all]
targets: emscripten
build: fails
contains: webcpp::hash: argon2 takes kdfs::argon2d, kdfs::argon2i or kdfs::argon2id.
