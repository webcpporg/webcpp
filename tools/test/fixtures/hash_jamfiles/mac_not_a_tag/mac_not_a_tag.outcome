# The compiler's line starts with the header's path on the machine, so the
# message is a contains: line. Natively and on WASI the same text is
# test/messages/mac_not_a_tag, a compile-diagnostic.
[all]
targets: emscripten
build: fails
contains: webcpp::hash: mac takes a tag of webcpp::hash::macs, as macs::hmac<digests::sha2_256>.
