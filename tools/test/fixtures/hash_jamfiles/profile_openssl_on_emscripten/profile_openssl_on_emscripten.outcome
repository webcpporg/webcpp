# The compiler's line of the #error starts with the header's path on the machine,
# so the message is a contains: line.
[all]
targets: emscripten
build: fails
contains: webcpp::hash: WEBCPP_HASH_PROFILE_BACKEND_OPENSSL selects OpenSSL, which is not built for Emscripten. Remove that define.
