# Every C library of webcpp::hash in one program, on Emscripten, where webcpp
# builds no OpenSSL: every_library's program.
exe app : ../every_library/app.cpp /webcpp/hash//hash /third_party//xkcp
  /third_party//blake3 /third_party//sodium /third_party//bearssl ;
