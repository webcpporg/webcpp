# The compiler's line starts with the header's path on the machine, so the
# message is a contains: line. Natively and on WASI the same text is
# test/messages/argon2id_on_hash2, a compile-diagnostic.
[all]
targets: emscripten
build: fails
contains: webcpp::hash: argon2id is in backends::sodium, backends::openssl and backends::botan alone. Name one, and add /third_party//sodium, /webcpp/hash//openssl or /third_party//botan to the program's Jamfile.
