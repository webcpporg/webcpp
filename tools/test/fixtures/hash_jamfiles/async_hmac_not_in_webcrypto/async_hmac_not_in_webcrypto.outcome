# The compiler's line starts with the header's path on the machine, so the
# message is a contains: line. Natively and on WASI the same text is
# test/messages/async_hmac_not_in_webcrypto, a compile-diagnostic.
[all]
targets: emscripten
build: fails
contains: webcpp::hash: async_hmac takes hmac_sha1_160, hmac_sha2_256, hmac_sha2_384 or hmac_sha2_512, the hmacs WebCrypto has: call mac for the others.
