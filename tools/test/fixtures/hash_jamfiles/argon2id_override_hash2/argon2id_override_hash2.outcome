# The compiler's line starts with the header's path on the machine, so the
# message is a contains: line. Natively and on WASI the same text is
# test/messages/argon2id_override_hash2, a compile-diagnostic.
[all]
targets: emscripten
build: fails
contains: webcpp::hash: argon2id is in backends::sodium alone. Name backends::sodium and add /third_party//sodium to the program's Jamfile.
