# BLAKE3's configuration, and so the canary's name, follows the machine natively:
# neon on arm64, x86 on x86-64; the linker's own words follow the system.
[all]
targets: native wasip2 wasip3 emscripten
build: fails
[native-darwin]
contains: Undefined symbols for architecture
[native-linux]
contains: undefined reference to `
[native-arm64]
contains: webcpp_hash_blake3_0000000_neon__add_third_party_blake3_to_your_link
[native-x86_64]
contains: webcpp_hash_blake3_0000000_x86__add_third_party_blake3_to_your_link
[wasip2]
contains: wasm-ld: error:
contains: undefined symbol: webcpp_hash_blake3_0000000_portable__add_third_party_blake3_to_your_link
[wasip3]
contains: wasm-ld: error:
contains: undefined symbol: webcpp_hash_blake3_0000000_portable__add_third_party_blake3_to_your_link
[emscripten]
contains: wasm-ld: error:
contains: undefined symbol: webcpp_hash_blake3_0000000_portable__add_third_party_blake3_to_your_link
contains: em++: error:
