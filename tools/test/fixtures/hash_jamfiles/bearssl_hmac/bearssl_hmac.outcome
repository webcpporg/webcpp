# The compiler's line starts with the header's path on the machine, so the
# message is a contains: line. Natively and on WASI the same text is
# test/messages/bearssl_hmac, a compile-diagnostic.
[all]
targets: emscripten
build: fails
contains: webcpp::hash: backends::bearssl has HKDF over hmac_md5_128, hmac_sha1_160, hmac_sha2_224, hmac_sha2_256, hmac_sha2_384 and hmac_sha2_512 alone. Over this hmac, name backends::hash2 (every hmac), backends::openssl (every hmac but hmac_ripemd_128) or backends::botan (every hmac but hmac_ripemd_128 and hmac_sha2_512_224).
