# The compiler's line starts with the header's path on the machine, so the
# message is a contains: line. Natively and on WASI the same text is
# test/messages/blake3_default_not_linked, a compile-diagnostic.
[all]
targets: emscripten
build: fails
contains: webcpp::hash: backends::blake3 needs BLAKE3's C implementation. Add /third_party//blake3 to the program's Jamfile: exe app : app.cpp /webcpp/hash//hash /third_party//blake3 ;
