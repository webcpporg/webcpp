# The compiler's line starts with the header's path on the machine, so the
# message is a contains: line. Natively and on WASI the same text is
# test/messages/async_digest_not_in_webcrypto, a compile-diagnostic.
[all]
targets: emscripten
build: fails
contains: webcpp::hash: async_digest takes digests::sha1, digests::sha2_256, digests::sha2_384 or digests::sha2_512, the digests WebCrypto has: call digest_of for the others.
