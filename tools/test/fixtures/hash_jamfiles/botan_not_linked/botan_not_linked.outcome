# The compiler's line starts with the header's path on the machine, so the
# message is a contains: line. Natively the same text is
# test/messages/botan_not_linked, a compile-diagnostic.
[all]
targets: emscripten
build: fails
contains: webcpp::hash: backends::botan needs Botan. Add /third_party//botan to the program's Jamfile (native and Emscripten, with exceptions): exe app : app.cpp /webcpp/hash//hash /third_party//botan ;
