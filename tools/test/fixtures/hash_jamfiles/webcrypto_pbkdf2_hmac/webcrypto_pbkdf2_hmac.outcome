# The compiler's line starts with the header's path on the machine, so the
# message is a contains: line. Its only target is Emscripten, where alone the
# asynchronous family takes backends::webcrypto.
[all]
targets: emscripten
build: fails
contains: webcpp::hash: backends::webcrypto has PBKDF2 over hmac_sha1_160, hmac_sha2_256, hmac_sha2_384 and hmac_sha2_512 alone: name a synchronous backend for the others.
