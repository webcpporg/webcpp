# The compiler's line starts with the header's path on the machine, so each
# message is a contains: line. Natively and on WASI the same texts are
# test/messages/kdf_standards_no_default, a compile-diagnostic.
[all]
targets: emscripten
build: fails
contains: webcpp::hash: kdfs::kbkdf_hmac has no default backend. Name one of: backends::openssl, backends::botan.
contains: webcpp::hash: kdfs::sskdf has no default backend. Name one of: backends::openssl, backends::botan.
contains: webcpp::hash: kdfs::x963kdf has no default backend. Name one of: backends::openssl, backends::botan.
