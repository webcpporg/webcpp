# The compiler's line starts with the header's path on the machine, so the
# message is a contains: line. Natively and on WASI the same text is
# test/messages/hasher_not_in_backend, a compile-diagnostic.
[all]
targets: emscripten
build: fails
contains: webcpp::hash: digests::blake3 is not in this backend. Name one of: backends::blake3.
