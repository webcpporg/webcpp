diff --git a/boost/cobalt/config.hpp b/boost/cobalt/config.hpp
--- a/boost/cobalt/config.hpp
+++ b/boost/cobalt/config.hpp
@@ -6,6 +6,7 @@
 //
 
 #include <boost/config.hpp>
+#include <cstddef>
 
 #ifndef BOOST_COBALT_CONFIG_HPP
 #define BOOST_COBALT_CONFIG_HPP
@@ -90,6 +91,21 @@ namespace pmr = boost::container::pmr;
 namespace pmr = std::pmr;
 #endif
 
+// The alignment of the storage cobalt gives a coroutine frame, and coroutine_align_t the unit of
+// the header before it. std::max_align_t is only 8-byte aligned on MSVC, but the compiler may emit
+// aligned SSE stores into the frame. Elsewhere they are alignof(std::max_align_t) and
+// std::max_align_t, as in Boost 1.92.0, so that nothing changes there.
+#if defined(BOOST_MSVC)
+constexpr static std::size_t coroutine_align = 16;
+struct alignas(coroutine_align) coroutine_align_t
+{
+  unsigned char bytes_[coroutine_align];
+};
+#else
+constexpr static std::size_t coroutine_align = alignof(std::max_align_t);
+using coroutine_align_t = std::max_align_t;
+#endif
+
 }
 
 #if !defined(BOOST_COBALT_SOURCE) && !defined(BOOST_ALL_NO_LIB) && !defined(BOOST_COBALT_NO_LIB)
