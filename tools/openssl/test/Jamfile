exe tls_client : tls_client.cpp /webcpp/asio//asio /webcpp/asio//openssl
    : <exception-handling>off:<source>/webcpp//throw_exception ;
exe entropy : entropy.c /webcpp/third_party//openssl
    : <toolset>clang-wasip3 <linkflags>-Wl,--wrap=getentropy ;
exe threads : threads.cpp /webcpp/third_party//openssl : <threading>multi ;
explicit tls_client entropy threads ;

exe tls_client_embedded : tls_client_embedded.cpp /webcpp/asio//tls
    : <exception-handling>off:<source>/webcpp//throw_exception ;
explicit tls_client_embedded ;

# Compatibility names resolve to the Cobalt-owned clients.
alias cobalt_tls_client : ../../../libs/cobalt/test/tls//cobalt_tls_client-program ;
explicit cobalt_tls_client ;
alias cobalt_ssl_client : ../../../libs/cobalt/test/tls//cobalt_ssl_client-program ;
explicit cobalt_ssl_client ;
alias cobalt_ssl_state : ../../../libs/cobalt/test/tls//cobalt_ssl_state-program ;
explicit cobalt_ssl_state ;
alias cobalt_ssl_cancel : ../../../libs/cobalt/test/tls//cobalt_ssl_cancel-program ;
explicit cobalt_ssl_cancel ;

# The native WebRTC backend needs worker threads and exceptions.
exe combined_provider : combined_provider.cpp /webcpp/asio//asio /webcpp/asio//openssl
    /webcpp/beast//beast /webcpp/trystero//native
    : <threading>multi <exception-handling>on ;
explicit combined_provider ;
