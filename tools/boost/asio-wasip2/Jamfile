import make ;
import webcpp-wasi ;
project /webcpp/asio-wasip2 ;
path-constant BUNDLE : . ;
path-constant OUTPUT : ../../../bin/boost-asio-wasip2 ;
make verified.stamp : verify.py wasi-libc/manifest.json : @verify
  : <location>$(OUTPUT) <webcpp-boost-check>off ;
always verified.stamp ;
explicit verified.stamp ;
rule verify ( targets * : sources * : properties * )
{
    SCRIPT on $(targets) = $(BUNDLE)/verify.py ;
    SDK on $(targets) = [ webcpp-wasi.sdk $(WEBCPP_ROOT) ] ;
}
actions verify
{
    python3 "$(SCRIPT)" --sdk "$(SDK)" --stamp "$(<)"
}
obj pollable : pollable.cpp
  : <include>../../../libs/asio/include <include>wasi-libc
    <dependency>verified.stamp <library>/webcpp/config//config ;
explicit pollable ;

# Private resolver extension selected only with the P2 platform overlay.
alias headers : : : : <include>include <library>/webcpp/asio-wasip3//headers ;
explicit headers ;
