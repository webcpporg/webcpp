import make ;

project /webcpp/cobalt-wasip3 ;
path-constant BUNDLE : . ;
path-constant OVERLAY : ../../../bin/boost-cobalt-wasip3 ;

make prepared.stamp : prepare.py manifest.json boost-1.92.patch : @prepare
    : <location>$(OVERLAY) <webcpp-boost-check>off ;
always prepared.stamp ;
explicit prepared.stamp ;

rule prepare ( targets * : sources * : properties * )
{
    SCRIPT on $(targets) = $(BUNDLE)/prepare.py ;
    HEADERS on $(targets) = $(WEBCPP_BOOST_HEADERS) ;
    SOURCES on $(targets) = $(WEBCPP_BOOST_SOURCE) ;
    OUTPUT on $(targets) = $(OVERLAY)/include ;
}

actions prepare
{
    python3 "$(SCRIPT)" --boost "$(HEADERS)" --sources "$(SOURCES)" --output "$(OUTPUT)" --stamp "$(<)"
}

alias headers : : : : <dependency>prepared.stamp
    <cxxflags>"-I\"$(OVERLAY)/include\""
    <library>/webcpp/asio-wasip3//headers ;
explicit headers ;

# These objects are built separately from boost_cobalt. Its free include flags
# do not reach them, so they must explicitly share the composition fix.
obj endpoint : endpoint.cpp : <library>headers <library>/webcpp/cobalt-common//headers
    <warnings>off <warnings-as-errors>off ;
obj acceptor : acceptor.cpp : <library>headers <library>/webcpp/cobalt-common//headers
    <warnings>off <warnings-as-errors>off ;
explicit endpoint acceptor ;
