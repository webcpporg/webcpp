import errors ;
import make ;
import webcpp-target ;

project /webcpp/cobalt-ssl ;
path-constant BUNDLE : . ;
path-constant OVERLAY : ../../../bin/boost-cobalt-ssl ;

make prepared.stamp : ../cobalt-wasip3/prepare.py manifest.json boost-1.92.patch : @prepare
    : <location>$(OVERLAY) <webcpp-boost-check>off ;
always prepared.stamp ;
explicit prepared.stamp ;

rule prepare ( targets * : sources * : properties * )
{
    SCRIPT on $(targets) = $(BUNDLE)/../cobalt-wasip3/prepare.py ;
    BUNDLE on $(targets) = $(BUNDLE) ;
    HEADERS on $(targets) = $(WEBCPP_BOOST_HEADERS) ;
    SOURCES on $(targets) = $(WEBCPP_BOOST_SOURCE) ;
    OUTPUT on $(targets) = $(OVERLAY)/include ;
}

actions prepare
{
    python3 "$(SCRIPT)" --boost "$(HEADERS)" --sources "$(SOURCES)" --output "$(OUTPUT)" --bundle "$(BUNDLE)" --stamp "$(<)"
}

rule supported ( properties * )
{
    if ! [ webcpp-target.target-of $(properties) ] in native wasip3
    {
        errors.user-error "Cobalt SSL requires native or WASIp3 with source-built OpenSSL." ;
    }
}

alias headers : : : : <dependency>prepared.stamp
    <cxxflags>"-I\"$(OVERLAY)/include\"" ;
explicit headers ;

lib boost_cobalt_io_ssl : ssl.cpp
    : <conditional>@supported <link>static <define>BOOST_COBALT_SSL_SOURCE=1
      <library>headers <library>/webcpp//boost_cobalt
      <library>/webcpp/third_party//openssl <warnings>off <warnings-as-errors>off
    : : <library>headers <library>/webcpp//boost_cobalt
      <library>/webcpp/third_party//openssl ;
explicit boost_cobalt_io_ssl ;
