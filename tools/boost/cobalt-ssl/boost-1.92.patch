 namespace boost::cobalt::io::ssl
 {
+namespace
+{
+// Inherit all associated properties, including cancellation, allocator and the
+// immediate executor. Update state before the base handler resumes the coroutine.
+template<bool SecureOnSuccess, typename... Args>
+struct state_handler : completion_handler<system::error_code, Args...>
+{
+  using base = completion_handler<system::error_code, Args...>;
+  bool & secure_;
+
+  state_handler(base handler, bool & secure)
+      : base(std::move(handler)), secure_(secure) {}
+
+  void operator()(system::error_code ec, Args... args)
+  {
+    secure_ = SecureOnSuccess && !ec;
+    base::operator()(ec, std::move(args)...);
+  }
+};
+}
+
+void stream::check_read_(void * self, mutable_buffer_sequence,
+                        cobalt::handler<system::error_code, std::size_t> handler)
+{
+  const auto & stream = *static_cast<ssl::stream *>(self);
+  if (stream.started_ && !stream.upgraded_)
+    handler(asio::error::not_connected, 0);
+}
+
+void stream::check_write_(void * self, const_buffer_sequence,
+                         cobalt::handler<system::error_code, std::size_t> handler)
+{
+  const auto & stream = *static_cast<ssl::stream *>(self);
+  if (stream.started_ && !stream.upgraded_)
+    handler(asio::error::not_connected, 0);
+}
+
 
