import make ;

project /webcpp/cobalt-common ;
path-constant BUNDLE : . ;
path-constant OVERLAY : ../../../bin/boost-cobalt-common ;

make prepared.stamp : ../cobalt-wasip3/prepare.py manifest.json boost-1.92.patch : @prepare
    : <location>$(OVERLAY) <webcpp-boost-check>off ;
always prepared.stamp ;
explicit prepared.stamp ;

rule prepare ( targets * : sources * : properties * )
{
    SCRIPT on $(targets) = $(BUNDLE)/../cobalt-wasip3/prepare.py ;
    BUNDLE on $(targets) = $(BUNDLE) ;
    HEADERS on $(targets) = $(WEBCPP_BOOST_HEADERS) ;
    SOURCES on $(targets) = $(WEBCPP_BOOST_SOURCE) ;
    OUTPUT on $(targets) = $(OVERLAY)/include ;
}

actions prepare
{
    python3 "$(SCRIPT)" --boost "$(HEADERS)" --sources "$(SOURCES)" --output "$(OUTPUT)" --bundle "$(BUNDLE)" --stamp "$(<)"
}

alias headers : : : : <dependency>prepared.stamp
    <cxxflags>"-I\"$(OVERLAY)/include\"" ;
explicit headers ;
